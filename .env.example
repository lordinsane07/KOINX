# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/koinx_reconciliation

# ── Redis (BullMQ job queue) ───────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
WORKER_CONCURRENCY=3

# ── Matching Tolerances (overridable per-run via POST body) ───────────────
TIMESTAMP_TOLERANCE_SECONDS=300
QUANTITY_TOLERANCE_PCT=0.01
REQUIRE_EXACT_TYPE=false

# ── Security ───────────────────────────────────────────────────────────────
ALLOWED_FILE_BASE_DIR=./data
MAX_CSV_FILE_BYTES=104857600
RECONCILE_RATE_LIMIT=10
REPORT_RATE_LIMIT=120

# ── Performance ────────────────────────────────────────────────────────────
MAX_CANDIDATE_WINDOW=1000
BULK_INSERT_CHUNK_SIZE=500
RUN_TIMEOUT_MS=300000

# ── Output ─────────────────────────────────────────────────────────────────
REPORT_OUTPUT_DIR=./reports

# ── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
UNMATCHED_RATE_WARN_THRESHOLD=0.20
